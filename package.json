{
  "name": "agentfx-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "validate:spec": "node scripts/validate-spec.mjs",
    "validate:packages": "node scripts/validate-packages.mjs",
    "demo": "node examples/memory.mjs",
    "demo:postgres": "node examples/postgres.mjs",
    "demo:mcp": "node examples/mcp.mjs",
    "bench": "node bench/run.mjs",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:integration && pnpm validate:spec && pnpm validate:packages && pnpm docs:build",
    "changeset": "changeset"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsdown": "0.23.0",
    "vitest": "5.0.2",
    "vitepress": "1.6.4",
    "publint": "0.3.24",
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.2",
    "prettier": "3.9.9",
    "eslint": "10.11.0",
    "typescript-eslint": "8.70.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "4.6.5",
    "@agentfx/contracts": "workspace:*",
    "@agentfx/diff": "workspace:*",
    "@agentfx/adapter-sdk": "workspace:*",
    "@agentfx/core": "workspace:*",
    "@agentfx/testing": "workspace:*",
    "@agentfx/openapi": "workspace:*",
    "@agentfx/mcp": "workspace:*",
    "@agentfx/cli": "workspace:*",
    "@agentfx/adapter-postgres": "workspace:*",
    "pg": "8.23.0",
    "ajv": "8.20.0"
  }
}
